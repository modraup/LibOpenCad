// acadrust R12Writer::write_exploded -> explode_dimension_with_style(dim, None).
// Only ARC_DIMENSION and LARGE_RADIAL_DIMENSION reach this fallback.
std::size_t R12Exporter::dimension_geometry(const DxfDimension &r, const Fields &f, bool paper) {
    const auto d = r.definition();
    std::size_t pieces = 0;
    auto line = [&](Point3 start, Point3 end) {
        pair(0, "LINE");
        common(r, f, paper);
        point(10, start);
        point(11, end);
        if (std::abs(d.normal.x) > 1e-12 || std::abs(d.normal.y) > 1e-12 || std::abs(d.normal.z - 1) > 1e-12)
            point(210, d.normal);
        ++pieces;
    };
    double measurement;
    if (const auto *arc = std::get_if<ArcDimension>(&d.geometry)) {
        line(arc->center_point, arc->first_extension_point);
        line(arc->center_point, arc->second_extension_point);
        if (arc->has_leader)
            line(arc->first_leader_point, arc->second_leader_point);
        const auto a = arc->first_extension_point - arc->center_point,
                   b = arc->second_extension_point - arc->center_point;
        const double tau = 2 * std::acos(-1.), raw = arc->end_parameter - arc->start_parameter;
        auto wrap = [tau](double value) {
            const double rem = std::fmod(value, tau);
            return rem < 0 ? rem + tau : rem;
        };
        double sweep = wrap(raw);
        if (sweep <= 1e-12)
            sweep = std::abs(raw) > 1e-12 ? tau : wrap(std::atan2(b.y, b.x) - std::atan2(a.y, a.x));
        measurement = a.length() * sweep;
        issue(R12IssueKind::Loss, "dimension-arc-omitted", &r,
              "Arc dimension line is not generated by the upstream R12 decomposition");
    } else {
        const auto &g = std::get<LargeRadialDimension>(d.geometry);
        line(d.definition_point, g.jog_point);
        line(g.jog_point, g.chord_point);
        measurement = d.definition_point.distance(g.chord_point);
    }
    issue(R12IssueKind::Loss, "dimension-decomposed", &r,
          "No usable local graphics block; editable dimension, associations and DIMSTYLE rendering are lost");
    issue(R12IssueKind::Loss, "dimension-arrows-omitted", &r,
          "Upstream detached arc/jogged-radius decomposition emits no arrowheads");
    if (d.text_override == " ")
        return pieces;
    if (!std::isfinite(measurement))
        throw std::invalid_argument("Nonfinite dimension measurement");
    std::ostringstream number;
    number.imbue(std::locale::classic());
    number << std::fixed << std::setprecision(4) << measurement;
    const auto formatted = number.str();
    const std::string_view source = d.text_override ? std::string_view(*d.text_override) : "<>";
    MTextDefinition text;
    auto append = [&](std::string_view part) {
        if (part.size() > options.max_output_bytes - text.text.size())
            throw std::length_error("Dimension text exceeds output budget");
        text.text.append(part);
    };
    if (source.rfind("\\A", 0) != 0)
        append("\\A1;");
    for (std::size_t start = 0;;) {
        const auto next = source.find("<>", start);
        append(source.substr(start, next == std::string_view::npos ? next : next - start));
        if (next == std::string_view::npos)
            break;
        append(formatted);
        start = next + 2;
    }
    text.insertion = d.text_middle_point;
    text.rotation = d.text_rotation;
    text.normal = d.normal;
    text.height = 2.5;
    text.rectangle_width = 0;
    text.attachment = d.attachment_point;
    text.style = d.style_name;
    for (const auto &piece : detail::approximate_mtext(text, options.max_output_bytes / 32)) {
        text_piece(r, f, paper, piece);
        ++pieces;
    }
    return pieces;
}
