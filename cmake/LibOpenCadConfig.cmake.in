@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Iconv)
find_dependency(ZLIB)
include("${CMAKE_CURRENT_LIST_DIR}/LibOpenCadTargets.cmake")
if(TARGET LibOpenCad::libopencad)
    set_property(TARGET LibOpenCad::libopencad APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES Iconv::Iconv ZLIB::ZLIB)
endif()
check_required_components(LibOpenCad)
